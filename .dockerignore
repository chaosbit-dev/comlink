# Ship only what the runtime image needs: pyproject.toml, uv.lock, src/, README.
# Everything else is excluded to keep the build context small and to avoid
# leaking local-only config (CF Access backups, .env) into image layers.

# Version control
.git
.gitignore
.gitattributes

# Virtualenvs / build outputs
.venv
venv
build
dist
*.egg-info
.eggs

# Python caches
__pycache__
*.py[cod]
*.pyc

# Tooling caches
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Tests, experiments, docs, evals — not part of the runtime
tests
experiments
docs
evals

# Comlink runtime artifacts (audit logs etc.) — never baked into the image
.comlink
*.jsonl

# Local-only Cloudflare Access app config backups
*app_backup.json

# Env / secrets — must never enter an image layer
.env
.env.*

# Deploy artifacts (this image doesn't need its own manifests inside it)
deploy
Dockerfile
.dockerignore

# OS / editor cruft
.DS_Store
.idea
.vscode
